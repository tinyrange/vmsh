[Unit]
Description=vmsh accelerated OpenArena GLX benchmark
DefaultDependencies=no
After=ccx3-stage2.service systemd-udev-trigger.service
Wants=ccx3-stage2.service systemd-udev-trigger.service

[Service]
Type=simple
ExecStart=/usr/local/bin/start-openarena
Restart=on-failure
RestartSec=1s
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
