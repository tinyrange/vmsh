#!/bin/bash

set -u

usage() {
    echo "Usage: qemu-gdb PROGRAM [ARG ...]"
}

if [ "$#" -eq 0 ]; then
    usage >&2
    exit 2
fi

case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
esac

program=$1
shift

if [ ! -f "$program" ]; then
    echo "qemu-gdb: $program: file not found" >&2
    exit 1
fi

machine=$(
    LC_ALL=C readelf -h -- "$program" 2>/dev/null |
        sed -n 's/^[[:space:]]*Machine:[[:space:]]*//p'
)
if [ "$machine" != "Advanced Micro Devices X86-64" ]; then
    echo "qemu-gdb: $program is not an x86-64 ELF executable" >&2
    exit 1
fi

port=$(
    python3 -c '
import socket
s = socket.socket()
s.bind(("127.0.0.1", 0))
print(s.getsockname()[1])
s.close()
'
)

qemu_pid=
cleanup() {
    if [ -n "$qemu_pid" ]; then
        kill "$qemu_pid" 2>/dev/null || true
        wait "$qemu_pid" 2>/dev/null || true
    fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 143' TERM

qemu-x86_64 -g "$port" "$program" "$@" &
qemu_pid=$!

ready=false
for _ in $(seq 1 100); do
    if ss -H -ltn "sport = :$port" | grep -q .; then
        ready=true
        break
    fi
    if ! kill -0 "$qemu_pid" 2>/dev/null; then
        wait "$qemu_pid"
        exit $?
    fi
    sleep 0.02
done

if [ "$ready" != true ]; then
    echo "qemu-gdb: QEMU did not open its debug port" >&2
    exit 1
fi

gdb-multiarch --quiet "$program" \
    -ex "set architecture i386:x86-64" \
    -ex "set sysroot /" \
    -ex "target remote 127.0.0.1:$port"
