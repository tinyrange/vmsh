[Unit]
Description=SquadVM Glass desktop
DefaultDependencies=no
After=ccx3-stage2.service squadvm-binfmt.service
Wants=ccx3-stage2.service squadvm-binfmt.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/squadvm-session
Restart=on-failure
RestartSec=1s
StandardInput=null
StandardOutput=append:/run/squadvm-desktop.log
StandardError=append:/run/squadvm-desktop.log

[Install]
WantedBy=squadvm.target
