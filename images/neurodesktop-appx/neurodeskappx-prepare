#!/usr/bin/env bash
set -euo pipefail

jovyan_group=$(id -gn jovyan)
state_dir=/home/jovyan/.local/state/NeurodeskAppX
migration_marker="$state_dir/image-v1-ready"

install -d -m 0755 -o jovyan -g "$jovyan_group" "$state_dir" /home/jovyan/Desktop
if [ -e "$migration_marker" ]; then
    exit 0
fi
touch "$state_dir/jupyter.log"
chown "jovyan:$jovyan_group" "$state_dir/jupyter.log" /home/jovyan/Desktop
chmod 0644 "$state_dir/jupyter.log"
install -m 0755 -o jovyan -g "$jovyan_group" \
    /usr/share/neurodeskappx/jupyterlab.desktop \
    /home/jovyan/Desktop/jupyterlab.desktop

for path in /home/jovyan/.vnc /home/jovyan/.neurodesk/guacamole; do
    if [ -d "$path" ]; then
        find "$path" -depth -delete
    fi
done

for path in \
    /home/jovyan/.neurodesk/secrets/guacamole_web_password \
    /home/jovyan/.neurodesk/secrets/guacamole_web_user \
    /home/jovyan/.neurodesk/secrets/vnc_password
do
    if [ -e "$path" ]; then
        find "$path" -delete
    fi
done

touch "$migration_marker"
chown "jovyan:$jovyan_group" "$migration_marker"
