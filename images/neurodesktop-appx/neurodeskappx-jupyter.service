[Unit]
Description=NeurodeskAppX JupyterLab
After=network.target

[Service]
Type=simple
User=jovyan
WorkingDirectory=/home/jovyan
Environment=HOME=/home/jovyan
Environment=USER=jovyan
Environment=LOGNAME=jovyan
Environment=NEURODESKTOP_JUPYTER_PORT=8888
Environment=JUPYTER_TOKEN=
Environment=JUPYTER_PASSWORD=
Environment=CVMFS_DISABLE=true
Environment=NEURODESKTOP_CVMFS_STARTUP_MODE=external
Environment=PATH=/opt/conda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=/usr/bin/truncate --size 0 /home/jovyan/.local/state/NeurodeskAppX/jupyter.log
ExecStart=/usr/local/bin/start-neurodesktop-jupyterlab
StandardOutput=append:/home/jovyan/.local/state/NeurodeskAppX/jupyter.log
StandardError=inherit
Restart=on-failure
RestartSec=2
TimeoutStopSec=30

[Install]
# Deliberately no WantedBy: the desktop icon is the only activation path.
