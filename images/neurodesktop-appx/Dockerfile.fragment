
# NeurodeskAppX integration. This fragment is appended to the Dockerfile
# generated by neurocontainers so the result remains an ordinary OCI image.
USER root
COPY neurodeskappx /tmp/neurodeskappx
RUN /tmp/neurodeskappx/customize.sh /tmp/neurodeskappx \
    && rm -rf /tmp/neurodeskappx
USER jovyan
WORKDIR /home/jovyan
